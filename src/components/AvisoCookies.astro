---
/**
 * Aviso de cookies.
 *
 * Por qué existe: la web solo carga UN elemento de terceros, el mapa de Google
 * de la sección "Dónde estamos". Todo lo demás es propio —las tipografías van
 * autoalojadas, las imágenes las procesa Astro, no hay analítica ni publicidad
 * ni formularios—, así que este aviso pregunta por una única cosa y lo dice.
 *
 * Requisitos de la AEPD que condicionan el diseño, no son decoración:
 *
 *   · RECHAZAR tiene que ser TAN FÁCIL como aceptar. Por eso los dos botones
 *     son idénticos en tamaño, estilo y jerarquía visual. Un "aceptar" en negro
 *     sólido junto a un "rechazar" en gris pequeño es justo lo que la guía de
 *     2023 señala como no conforme.
 *   · Nada de casillas premarcadas.
 *   · Nada de muro de cookies: se puede seguir usando la web entera sin aceptar.
 *   · El consentimiento debe poder retirarse. De ahí el enlace "Configuración de
 *     cookies" del pie, que vuelve a abrir este aviso.
 *   · Y lo más importante: la cookie NO se instala antes del consentimiento. El
 *     iframe del mapa se queda sin `src` hasta que hay un sí explícito.
 *
 * No lleva fondo oscuro ni bloquea la página a propósito: es una franja baja,
 * en el papel de la marca, que se puede ignorar. Intrusivo no significa
 * conforme, y aquí no hace falta serlo.
 *
 * La decisión se guarda en localStorage y no en una cookie. Es almacenamiento
 * estrictamente necesario para prestar el servicio que el usuario ha pedido
 * —recordar su propia elección—, así que está exento del artículo 22.2.
 */
---

<aside class="aviso" id="aviso-cookies" role="region" aria-label="Aviso de cookies" hidden>
  <p class="texto">
    Solo usamos cookies de terceros para mostrar el mapa de Google. Nada más: ni
    analítica, ni publicidad. <a href="/politica-de-cookies/">Más información</a>.
  </p>

  <div class="acciones">
    <button type="button" class="boton" data-cookies="rechazar">Rechazar</button>
    <button type="button" class="boton" data-cookies="aceptar">Aceptar</button>
  </div>
</aside>

<script is:inline>
  /*
   * Va en línea y sin `defer` para que la decisión se aplique antes del primer
   * pintado. Con el script diferido, el aviso aparecería y desaparecería de
   * golpe en cada visita de quien ya decidió, que es un parpadeo feo.
   */
  ;(() => {
    const CLAVE = 'nn-cookies'
    const aviso = document.getElementById('aviso-cookies')
    if (!aviso) return

    /** Da luz verde a todo lo que espera consentimiento. Hoy, solo el mapa. */
    function activarTerceros() {
      document.querySelectorAll('[data-src-consentido]').forEach((elemento) => {
        const destino = elemento.getAttribute('data-src-consentido')
        if (destino && !elemento.getAttribute('src')) elemento.setAttribute('src', destino)
      })
      document.querySelectorAll('[data-sin-consentimiento]').forEach((elemento) => {
        elemento.setAttribute('hidden', '')
      })
    }

    function mostrar() {
      aviso.removeAttribute('hidden')
    }

    function decidir(valor) {
      try {
        localStorage.setItem(CLAVE, valor)
      } catch {
        // Navegación privada con almacenamiento bloqueado: se respeta la
        // decisión en esta visita aunque no se pueda recordar.
      }
      aviso.setAttribute('hidden', '')
      if (valor === 'aceptar') activarTerceros()
    }

    let guardado = null
    try {
      guardado = localStorage.getItem(CLAVE)
    } catch {
      guardado = null
    }

    if (guardado === 'aceptar') activarTerceros()
    else if (guardado !== 'rechazar') mostrar()

    aviso.querySelectorAll('[data-cookies]').forEach((boton) => {
      boton.addEventListener('click', () => decidir(boton.getAttribute('data-cookies')))
    })

    /*
     * Permite retirar o dar el consentimiento desde el pie y desde el marcador
     * del propio mapa. Sin esto, quien rechaza no tiene forma de cambiar de
     * opinión, y eso el RGPD lo exige.
     */
    window.abrirAvisoCookies = mostrar
    document.querySelectorAll('[data-abrir-cookies]').forEach((disparador) => {
      disparador.addEventListener('click', (evento) => {
        evento.preventDefault()
        mostrar()
      })
    })
  })()
</script>

<style>
  /*
    Sin esta regla el aviso NO se oculta nunca.
    El atributo `hidden` solo aplica `display: none` desde la hoja de estilos del
    navegador, y cualquier `display` declarado aquí la pisa. Con `display: grid`
    más abajo, pulsar Aceptar o Rechazar dejaba el banner en pantalla y parecía
    que los botones no hacían nada.
  */
  .aviso[hidden] {
    display: none;
  }

  .aviso {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 20;
    display: grid;
    gap: var(--espacio-md);
    padding: var(--espacio-md) var(--margen);
    background: var(--papel);
    border-top: 1px solid var(--linea);
    /* Sombra muy corta: separa del contenido sin parecer una ventana modal. */
    box-shadow: 0 -1px 24px oklch(0 0 0 / 0.06);
    animation: entrar 0.5s var(--salida) both;
  }

  /* En móvil la barra de reserva ya ocupa el borde inferior: el aviso se apoya
     encima en lugar de taparla. El CTA nunca queda oculto. */
  @media (max-width: 47.99rem) {
    .aviso {
      bottom: calc(3.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .texto {
    max-width: 68ch;
    color: var(--tinta-media);
    font-size: var(--texto-sm);
    text-wrap: pretty;
  }

  .texto a {
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 1px solid var(--borde);
    transition: border-color 0.4s var(--salida);
  }

  .texto a:hover {
    border-color: var(--tinta);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-sm);
  }

  /*
    Los dos botones son EXACTAMENTE iguales.
    No es una decisión estética: la AEPD exige que rechazar cueste lo mismo que
    aceptar. En cuanto uno de los dos destaca sobre el otro, el consentimiento
    deja de considerarse libre.
  */
  .boton {
    flex: 1 1 auto;
    min-width: 8.5rem;
    /* Objetivo táctil holgado: la mayoría del tráfico es móvil. */
    min-height: 2.75rem;
    padding: 0.7rem var(--espacio-md);
    background: transparent;
    color: var(--tinta);
    border: 1px solid var(--tinta);
    font-family: var(--texto);
    font-size: var(--texto-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.4s var(--salida),
      color 0.4s var(--salida);
  }

  @media (hover: hover) {
    .boton:hover {
      background: var(--tinta);
      color: var(--papel);
    }
  }

  @media (min-width: 48rem) {
    .aviso {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--espacio-xl);
    }

    .boton {
      flex: 0 0 auto;
    }
  }

  @keyframes entrar {
    from {
      translate: 0 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso {
      animation: none;
    }
  }
</style>
