---
import { Image } from 'astro:assets'
import BotonReserva from './BotonReserva.astro'
import { trabajos, trabajosDe, etiquetasCategoria, type CategoriaTrabajo } from '../data/galeria'
import { negocio } from '../data/negocio'

/**
 * La única sección invertida de la página.
 *
 * No es decoración: el color de las uñas revienta sobre negro, y la inversión
 * marca el cambio de registro entre "lo que cuesta" y "lo que hace".
 *
 * Todas las fotos comparten relación 4:5, así que la variación del mosaico
 * viene del tamaño de celda y no de recortes distintos. Sin esa disciplina el
 * conjunto se ve amateur, que es justo el problema de la web antigua.
 */
type Props = {
  /** Filtra el mosaico. Sin esto, todos los trabajos. */
  categoria?: CategoriaTrabajo
  titulo?: string
  entradilla?: string
}

const {
  categoria,
  titulo = 'Trabajos',
  entradilla = 'Todo lo que ves está hecho en el salón. Si traes una foto de referencia, mejor.',
} = Astro.props

const visibles = categoria ? trabajosDe(categoria) : trabajos
const categorias = Object.entries(etiquetasCategoria) as [CategoriaTrabajo, string][]
---

<section class="seccion galeria" id="trabajos" data-invertido>
  <div class="cabecera-seccion">
    <h2 class="titulo-seccion">{titulo}</h2>
    <p class="entradilla">{entradilla}</p>
  </div>

  {
    !categoria && (
      <div class="filtros" aria-label="Filtrar trabajos por servicio">
        <span class="etiqueta-filtros">Ver por</span>
        <div class="lista-filtros" role="group">
          <button class="filtro activo" type="button" data-filtro="todos" aria-pressed="true">Todos</button>
          {categorias.map(([id, etiqueta]) => (
            <button class="filtro" type="button" data-filtro={id} aria-pressed="false">{etiqueta}</button>
          ))}
        </div>
      </div>
    )
  }

  <ul class="mosaico" data-galeria-lista>
    {
      visibles.map((trabajo) => (
        <li class="pieza" tabindex="0" aria-label={`${trabajo.titulo ?? trabajo.alt}. ${trabajo.descripcion ?? ''} Servicio: ${trabajo.categorias.map((id) => etiquetasCategoria[id]).join(', ')}`} data-titulo={trabajo.titulo ?? trabajo.alt} data-descripcion={trabajo.descripcion ?? trabajo.alt} data-servicio={trabajo.categorias.map((id) => etiquetasCategoria[id]).join(' · ')} data-categorias={trabajo.categorias.join(' ')} data-destacada={trabajo.destacada ? '' : undefined} data-revelar>
          <Image
            src={trabajo.imagen}
            alt={trabajo.alt}
            widths={[320, 480, 720]}
            sizes="(min-width: 75rem) 22vw, (min-width: 48rem) 30vw, 45vw"
            loading="lazy"
          />
          <div class="overlay" aria-hidden="true">
            <div class="overlay-contenido">
              <span class="overlay-servicio">
                {trabajo.categorias.map((id, indice) => (
                  <>{indice > 0 && ' · '}{etiquetasCategoria[id]}</>
                ))}
              </span>
              <h3>{trabajo.titulo ?? trabajo.alt}</h3>
              <p>{trabajo.descripcion ?? trabajo.alt}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="cierre">
    <p class="nota">
      Hay muchos más en Instagram, y ahí se publican los últimos.
    </p>
    <div class="acciones">
      <BotonReserva variante="inverso" texto="Pedir cita" />
      <a class="enlace-instagram toque" href={negocio.redes.instagram} target="_blank" rel="noopener noreferrer">
        Ver {negocio.redes.instagramUsuario}
      </a>
    </div>
  </div>
  <dialog class="visor" data-visor aria-labelledby="visor-titulo">
    <div class="visor-marco">
      <button class="visor-cerrar" type="button" data-visor-cerrar aria-label="Cerrar visor"><span aria-hidden="true"></span></button>

      <div class="visor-media" data-visor-media>
        <img data-visor-imagen src="" alt="" />
        <button class="visor-control anterior" type="button" data-visor-anterior aria-label="Trabajo anterior"><span aria-hidden="true"></span></button>
        <button class="visor-control siguiente" type="button" data-visor-siguiente aria-label="Trabajo siguiente"><span aria-hidden="true"></span></button>
      </div>

      <div class="visor-info">
        <p class="visor-kicker">Detalle del trabajo</p>
        <h2 class="visor-titulo" id="visor-titulo" data-visor-titulo></h2>
        <p class="visor-servicio" data-visor-servicio></p>
        <p class="visor-descripcion" data-visor-descripcion></p>
        <p class="visor-contador" data-visor-contador aria-live="polite"></p>
      </div>
    </div>
  </dialog>
</section>

<style>
  .galeria {
    background: var(--tinta);
    color: var(--papel);
  }

  .cabecera-seccion {
    display: grid;
    gap: var(--espacio-sm);
    padding-inline: var(--margen);
    margin-bottom: var(--espacio-xl);
  }

  .filtros {
    display: grid;
    gap: var(--espacio-sm);
    padding-inline: var(--margen);
    margin-bottom: var(--espacio-lg);
  }

  .etiqueta-filtros,
  .overlay-servicio {
    color: var(--sobre-tinta-suave);
    font-size: var(--texto-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lista-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2xs) var(--espacio-sm);
  }

  .filtro {
    appearance: none;
    border: 0;
    border-bottom: 1px solid var(--tinta-media);
    background: transparent;
    color: var(--sobre-tinta-suave);
    cursor: pointer;
    font-size: var(--texto-sm);
    padding: 0.15rem 0 0.35rem;
    transition: border-color 0.4s var(--salida), color 0.4s var(--salida);
  }

  .filtro:hover,
  .filtro.activo {
    border-color: var(--papel);
    color: var(--papel);
  }

  .mosaico {
    display: grid;
    /* dense rellena los huecos que dejan las piezas de doble tamaño. */
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espacio-2xs);
    list-style: none;
    margin: 0;
    padding-inline: var(--margen);
  }

  .pieza {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--tinta-media);
  }

  /*
    Las piezas grandes solo se activan a partir de tres columnas.

    Con dos columnas, una pieza de doble ancho ocupa la fila entera y no queda
    ninguna pieza normal que le fije la altura a esa fila: la rejilla colapsa y
    deja un hueco enorme. A partir de tres columnas siempre hay al menos una
    pieza normal a su lado marcando el alto, así que la grande solo necesita
    ocupar dos columnas y estirarse.
  */
  @media (min-width: 48rem) {
    .pieza[data-destacada] {
      grid-column: span 2;
      /*
        La imagen se saca del flujo para que la pieza ancha no tenga altura
        propia. Si la conserva, al medir dos columnas de ancho reclama una
        altura mayor que la de la fila, estira la fila y deja huecos junto a
        las piezas normales, que sí tienen proporción fija. Sin altura propia,
        adopta la de la fila y la imagen la rellena.
      */
      position: relative;
      aspect-ratio: auto;
      min-height: 0;
    }

    .pieza[data-destacada] :global(img) {
      position: absolute;
      inset: 0;
    }
  }

  .pieza :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--salida);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--espacio-md);
    background: linear-gradient(180deg, transparent 28%, oklch(0.1 0.01 350 / 0.88) 100%);
    opacity: 0;
    transition: opacity 0.5s var(--salida);
  }

  .overlay-contenido {
    transform: translateY(0.75rem);
    transition: transform 0.5s var(--salida);
  }

  .overlay p {
    color: var(--papel);
    font-family: var(--display);
    font-size: var(--texto-lg);
    line-height: 1.15;
    margin-top: var(--espacio-2xs);
    max-width: 25ch;
  }

  .overlay h3 {
    color: var(--papel);
    font-family: var(--display);
    font-size: var(--texto-lg);
    line-height: 1.15;
    margin-top: var(--espacio-2xs);
  }

  .overlay p {
    font-family: var(--texto);
    font-size: var(--texto-sm);
    line-height: 1.35;
    margin-top: var(--espacio-2xs);
  }

  @media (hover: hover) {
    .pieza:hover .overlay {
      opacity: 1;
    }

    .pieza:hover .overlay-contenido {
      transform: translateY(0);
    }
  }

  .pieza:focus-within .overlay {
    opacity: 1;
  }

  .pieza:focus-within .overlay-contenido {
    transform: translateY(0);
  }

  .pieza[data-oculta] {
    display: none;
  }

  .pieza {
    cursor: zoom-in;
  }

  .pieza:focus-visible {
    outline: 2px solid var(--papel);
    outline-offset: -4px;
  }

  .visor {
    box-sizing: border-box;
    inline-size: min(92%, 72rem);
    max-inline-size: calc(100% - 2rem);
    margin: auto;
    max-height: 92vh;
    padding: 0;
    border: 1px solid var(--tinta-media);
    background: var(--tinta);
    color: var(--papel);
    overflow: hidden;
    opacity: 0;
    transform: translateY(0.75rem) scale(0.985);
    transition:
      opacity 0.45s var(--salida),
      transform 0.45s var(--salida),
      display 0.45s allow-discrete,
      overlay 0.45s allow-discrete;
    will-change: opacity, transform;
  }

  .visor[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .visor[open] {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
  }

  .visor::backdrop {
    background: oklch(0.08 0.01 350 / 0.88);
    backdrop-filter: blur(0.5rem);
    opacity: 0;
    transition: opacity 0.45s var(--salida), overlay 0.45s allow-discrete;
  }

  .visor[open]::backdrop {
    opacity: 1;
  }

  .visor-marco {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    min-height: min(70vh, 48rem);
    position: relative;
  }

  .visor-media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 20rem;
    padding: var(--espacio-lg);
    background: oklch(0.1 0.008 350);
    touch-action: pan-y;
  }

  .visor-media img {
    width: 100%;
    height: 100%;
    max-height: 76vh;
    object-fit: contain;
    opacity: 1;
    transform: translateX(0) scale(1);
    transition: opacity 0.24s var(--salida), transform 0.34s var(--salida);
  }

  .visor-media[data-cambiando] img {
    opacity: 0;
    transform: translateX(0.75rem) scale(0.985);
  }

  .visor-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--espacio-sm);
    padding: var(--espacio-xl) var(--espacio-lg) var(--espacio-lg);
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.24s var(--salida), transform 0.34s var(--salida);
  }

  .visor-info[data-cambiando] {
    opacity: 0;
    transform: translateY(0.5rem);
  }

  .visor-kicker,
  .visor-servicio,
  .visor-contador {
    color: var(--sobre-tinta-suave);
    font-size: var(--texto-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .visor-servicio {
    color: var(--papel);
  }

  .visor-titulo {
    font-family: var(--display);
    font-size: clamp(1.65rem, 1.3rem + 1.4vw, 2.6rem);
    line-height: 1.08;
    max-width: 16ch;
  }

  .visor-descripcion {
    font-family: var(--display);
    font-size: clamp(1.65rem, 1.3rem + 1.4vw, 2.6rem);
    line-height: 1.08;
    max-width: 16ch;
  }

  .visor-contador {
    margin-top: var(--espacio-md);
  }

  .visor-cerrar,
  .visor-control {
    appearance: none;
    display: grid;
    place-items: center;
    border: 1px solid oklch(0.985 0.002 350 / 0.35);
    background: oklch(0.1 0.01 350 / 0.7);
    color: var(--papel);
    cursor: pointer;
    transition: background 0.35s var(--salida), border-color 0.35s var(--salida);
  }

  .visor-cerrar span,
  .visor-control span {
    display: block;
    position: relative;
    flex: none;
  }

  .visor-cerrar:hover,
  .visor-control:hover {
    border-color: var(--papel);
    background: oklch(0.1 0.01 350 / 0.95);
  }

  .visor-cerrar {
    position: absolute;
    z-index: 1;
    top: var(--espacio-sm);
    right: var(--espacio-sm);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    padding: 0;
  }

  .visor-cerrar span {
    width: 1rem;
    height: 1rem;
  }

  .visor-cerrar span::before,
  .visor-cerrar span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.15rem;
    height: 1px;
    background: currentColor;
  }

  .visor-cerrar span::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .visor-cerrar span::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .visor-control {
    position: absolute;
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    padding: 0;
    transform: translateY(-50%);
  }

  .visor-control span {
    width: 0.65rem;
    height: 0.65rem;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
  }

  .visor-control.anterior span {
    transform: rotate(-135deg) translate(-0.08rem, -0.08rem);
  }

  .visor-control.siguiente span {
    transform: rotate(45deg) translate(-0.08rem, -0.08rem);
  }

  .visor-control:disabled {
    cursor: default;
    opacity: 0.3;
    pointer-events: none;
  }

  .anterior {
    left: var(--espacio-sm);
  }

  .siguiente {
    right: var(--espacio-sm);
  }

  @media (max-width: 47.99rem) {
    .visor {
      inline-size: 100%;
      max-inline-size: 100%;
      max-height: 100dvh;
      border: 0;
    }

    .visor-marco {
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }

    .visor-media {
      flex: 1 1 auto;
      min-height: 0;
      padding: 3.5rem var(--espacio-md) var(--espacio-md);
    }

    .visor-media img {
      max-height: 65dvh;
    }

    .visor-info {
      flex: 0 0 auto;
      gap: var(--espacio-2xs);
      padding: var(--espacio-md) var(--margen) var(--espacio-lg);
    }

    .visor-descripcion {
      font-size: var(--texto-xl);
      max-width: 22ch;
    }

    .visor-contador {
      margin-top: var(--espacio-xs);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pieza:hover :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay,
    .overlay-contenido,
    .pieza :global(img) {
      transition: none;
    }

    .visor::backdrop {
      backdrop-filter: none;
    }

    .visor,
    .visor::backdrop,
    .visor-media img,
    .visor-info {
      transition: none;
    }
  }

  .cierre {
    display: grid;
    gap: var(--espacio-md);
    padding-inline: var(--margen);
    margin-top: var(--espacio-xl);
  }

  .nota {
    color: var(--sobre-tinta-suave);
    max-width: 40ch;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-md);
  }

  .enlace-instagram {
    font-size: var(--texto-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--tinta-media);
    transition: border-color 0.4s var(--salida);
  }

  .enlace-instagram:hover {
    border-color: var(--papel);
  }

  @media (min-width: 48rem) {
    .mosaico {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espacio-xs);
    }
  }

  @media (min-width: 75rem) {
    .mosaico {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  const galerias = document.querySelectorAll('[data-galeria-lista]')

  galerias.forEach((galeria) => {
    const filtros = galeria.closest('[data-invertido]')?.querySelectorAll('[data-filtro]')
    const piezas = galeria.querySelectorAll('[data-categorias]')
    const visor = galeria.closest('[data-invertido]')?.querySelector('[data-visor]')

    if (!(visor instanceof HTMLDialogElement)) return

    const imagen = visor.querySelector('[data-visor-imagen]') as HTMLImageElement | null
    const servicio = visor.querySelector('[data-visor-servicio]')
    const titulo = visor.querySelector('[data-visor-titulo]')
    const descripcion = visor.querySelector('[data-visor-descripcion]')
    const contador = visor.querySelector('[data-visor-contador]')
    const anterior = visor.querySelector('[data-visor-anterior]') as HTMLButtonElement | null
    const siguiente = visor.querySelector('[data-visor-siguiente]') as HTMLButtonElement | null
    const cerrar = visor.querySelector('[data-visor-cerrar]') as HTMLButtonElement | null
    let indiceActual = 0
    let piezaAnterior: Element | null = null
    let inicioToque = 0
    const media = visor.querySelector('[data-visor-media]') as HTMLElement | null
    const info = visor.querySelector('.visor-info') as HTMLElement | null
    let temporizadorCambio: number | undefined

    const piezasVisibles = () => [...piezas].filter((pieza) => !pieza.hasAttribute('data-oculta'))

    const pintar = (indice: number) => {
      const visibles = piezasVisibles()
      const pieza = visibles[indice]
      const foto = pieza?.querySelector('img')

      if (!pieza || !foto || !imagen || !servicio || !titulo || !descripcion || !contador || !anterior || !siguiente) return

      const actualizar = () => {
        indiceActual = indice
        imagen.src = foto.currentSrc || foto.src
        imagen.alt = foto.alt
        titulo.textContent = pieza.getAttribute('data-titulo') ?? foto.alt
        servicio.textContent = pieza.getAttribute('data-servicio') ?? ''
        descripcion.textContent = pieza.getAttribute('data-descripcion') ?? foto.alt
        contador.textContent = `${indice + 1} / ${visibles.length}`
        anterior.toggleAttribute('disabled', indice === 0)
        siguiente.toggleAttribute('disabled', indice === visibles.length - 1)
      }

      if (!visor.open || !media || !info) {
        actualizar()
        return
      }

      window.clearTimeout(temporizadorCambio)
      media.setAttribute('data-cambiando', '')
      info.setAttribute('data-cambiando', '')
      temporizadorCambio = window.setTimeout(() => {
        actualizar()
        window.requestAnimationFrame(() => {
          media.removeAttribute('data-cambiando')
          info.removeAttribute('data-cambiando')
        })
      }, 140)
    }

    const abrir = (pieza: Element) => {
      const indice = piezasVisibles().indexOf(pieza)
      if (indice < 0) return
      piezaAnterior = pieza
      pintar(indice)
      visor.showModal()
      cerrar?.focus()
    }

    const cerrarVisor = () => {
      visor.close()
      if (piezaAnterior instanceof HTMLElement) piezaAnterior.focus()
    }

    piezas.forEach((pieza) => {
      pieza.addEventListener('click', () => abrir(pieza))
      ;(pieza as HTMLElement).addEventListener('keydown', (evento) => {
        if (evento.key === 'Enter' || evento.key === ' ') {
          evento.preventDefault()
          abrir(pieza)
        }
      })
    })

    cerrar?.addEventListener('click', cerrarVisor)
    anterior?.addEventListener('click', () => pintar(indiceActual - 1))
    siguiente?.addEventListener('click', () => pintar(indiceActual + 1))

    visor.addEventListener('click', (evento) => {
      if (evento.target === visor) cerrarVisor()
    })

    visor.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowLeft' && indiceActual > 0) pintar(indiceActual - 1)
      if (evento.key === 'ArrowRight' && indiceActual < piezasVisibles().length - 1) pintar(indiceActual + 1)
      if (evento.key === 'Escape') cerrarVisor()
    })

    media?.addEventListener('pointerdown', (evento) => {
      inicioToque = evento.clientX
    })
    media?.addEventListener('pointerup', (evento) => {
      const diferencia = evento.clientX - inicioToque
      if (Math.abs(diferencia) < 45) return
      if (diferencia < 0 && indiceActual < piezasVisibles().length - 1) pintar(indiceActual + 1)
      if (diferencia > 0 && indiceActual > 0) pintar(indiceActual - 1)
    })

    filtros?.forEach((filtro) => {
      filtro.addEventListener('click', () => {
        const categoria = filtro.getAttribute('data-filtro')

        filtros.forEach((otro) => {
          const activo = otro === filtro
          otro.classList.toggle('activo', activo)
          otro.setAttribute('aria-pressed', String(activo))
        })

        piezas.forEach((pieza) => {
          const visible = categoria === 'todos' || pieza.getAttribute('data-categorias')?.split(' ').includes(categoria ?? '')
          pieza.toggleAttribute('data-oculta', !visible)
        })
      })
    })
  })
</script>
