---
import { Image } from 'astro:assets'
import BotonReserva from './BotonReserva.astro'
import { trabajos, trabajosDe, etiquetasCategoria, type CategoriaTrabajo } from '../data/galeria'
import { negocio } from '../data/negocio'

/**
 * La única sección invertida de la página.
 *
 * No es decoración: el color de las uñas revienta sobre negro, y la inversión
 * marca el cambio de registro entre "lo que cuesta" y "lo que hace".
 *
 * Todas las fotos comparten relación 4:5, así que la variación del mosaico
 * viene del tamaño de celda y no de recortes distintos. Sin esa disciplina el
 * conjunto se ve amateur, que es justo el problema de la web antigua.
 */
type Props = {
  /** Filtra el mosaico. Sin esto, todos los trabajos. */
  categoria?: CategoriaTrabajo
  titulo?: string
  entradilla?: string
}

const {
  categoria,
  titulo = 'Trabajos',
  entradilla = 'Todo lo que ves está hecho en el salón. Si traes una foto de referencia, mejor.',
} = Astro.props

const visibles = categoria ? trabajosDe(categoria) : trabajos
const categorias = Object.entries(etiquetasCategoria) as [CategoriaTrabajo, string][]
---

<section class="seccion galeria" id="trabajos" data-invertido>
  <div class="cabecera-seccion">
    <h2 class="titulo-seccion">{titulo}</h2>
    <p class="entradilla">{entradilla}</p>
  </div>

  {
    !categoria && (
      <div class="filtros" aria-label="Filtrar trabajos por servicio">
        <span class="etiqueta-filtros">Ver por</span>
        <div class="lista-filtros" role="group">
          <button class="filtro activo" type="button" data-filtro="todos" aria-pressed="true">Todos</button>
          {categorias.map(([id, etiqueta]) => (
            <button class="filtro" type="button" data-filtro={id} aria-pressed="false">{etiqueta}</button>
          ))}
        </div>
      </div>
    )
  }

  <ul class="mosaico" data-galeria-lista>
    {
      visibles.map((trabajo) => (
        <li class="pieza" tabindex="0" aria-label={`${trabajo.descripcion ?? trabajo.alt}. Servicio: ${trabajo.categorias.map((id) => etiquetasCategoria[id]).join(', ')}`} data-categorias={trabajo.categorias.join(' ')} data-destacada={trabajo.destacada ? '' : undefined} data-revelar>
          <Image
            src={trabajo.imagen}
            alt={trabajo.alt}
            widths={[320, 480, 720]}
            sizes="(min-width: 75rem) 22vw, (min-width: 48rem) 30vw, 45vw"
            loading="lazy"
          />
          <div class="overlay" aria-hidden="true">
            <div class="overlay-contenido">
              <span class="overlay-servicio">
                {trabajo.categorias.map((id, indice) => (
                  <>{indice > 0 && ' · '}{etiquetasCategoria[id]}</>
                ))}
              </span>
              <p>{trabajo.descripcion ?? trabajo.alt}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="cierre">
    <p class="nota">
      Hay muchos más en Instagram, y ahí se publican los últimos.
    </p>
    <div class="acciones">
      <BotonReserva variante="inverso" texto="Pedir cita" />
      <a class="enlace-instagram toque" href={negocio.redes.instagram} target="_blank" rel="noopener noreferrer">
        Ver {negocio.redes.instagramUsuario}
      </a>
    </div>
  </div>
</section>

<style>
  .galeria {
    background: var(--tinta);
    color: var(--papel);
  }

  .cabecera-seccion {
    display: grid;
    gap: var(--espacio-sm);
    padding-inline: var(--margen);
    margin-bottom: var(--espacio-xl);
  }

  .filtros {
    display: grid;
    gap: var(--espacio-sm);
    padding-inline: var(--margen);
    margin-bottom: var(--espacio-lg);
  }

  .etiqueta-filtros,
  .overlay-servicio {
    color: var(--sobre-tinta-suave);
    font-size: var(--texto-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lista-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2xs) var(--espacio-sm);
  }

  .filtro {
    appearance: none;
    border: 0;
    border-bottom: 1px solid var(--tinta-media);
    background: transparent;
    color: var(--sobre-tinta-suave);
    cursor: pointer;
    font-size: var(--texto-sm);
    padding: 0.15rem 0 0.35rem;
    transition: border-color 0.4s var(--salida), color 0.4s var(--salida);
  }

  .filtro:hover,
  .filtro.activo {
    border-color: var(--papel);
    color: var(--papel);
  }

  .mosaico {
    display: grid;
    /* dense rellena los huecos que dejan las piezas de doble tamaño. */
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espacio-2xs);
    list-style: none;
    margin: 0;
    padding-inline: var(--margen);
  }

  .pieza {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--tinta-media);
  }

  /*
    Las piezas grandes solo se activan a partir de tres columnas.

    Con dos columnas, una pieza de doble ancho ocupa la fila entera y no queda
    ninguna pieza normal que le fije la altura a esa fila: la rejilla colapsa y
    deja un hueco enorme. A partir de tres columnas siempre hay al menos una
    pieza normal a su lado marcando el alto, así que la grande solo necesita
    ocupar dos columnas y estirarse.
  */
  @media (min-width: 48rem) {
    .pieza[data-destacada] {
      grid-column: span 2;
      /*
        La imagen se saca del flujo para que la pieza ancha no tenga altura
        propia. Si la conserva, al medir dos columnas de ancho reclama una
        altura mayor que la de la fila, estira la fila y deja huecos junto a
        las piezas normales, que sí tienen proporción fija. Sin altura propia,
        adopta la de la fila y la imagen la rellena.
      */
      position: relative;
      aspect-ratio: auto;
      min-height: 0;
    }

    .pieza[data-destacada] :global(img) {
      position: absolute;
      inset: 0;
    }
  }

  .pieza :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--salida);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--espacio-md);
    background: linear-gradient(180deg, transparent 28%, oklch(0.1 0.01 350 / 0.88) 100%);
    opacity: 0;
    transition: opacity 0.5s var(--salida);
  }

  .overlay-contenido {
    transform: translateY(0.75rem);
    transition: transform 0.5s var(--salida);
  }

  .overlay p {
    color: var(--papel);
    font-family: var(--display);
    font-size: var(--texto-lg);
    line-height: 1.15;
    margin-top: var(--espacio-2xs);
    max-width: 25ch;
  }

  @media (hover: hover) {
    .pieza:hover .overlay {
      opacity: 1;
    }

    .pieza:hover .overlay-contenido {
      transform: translateY(0);
    }
  }

  .pieza:focus-within .overlay {
    opacity: 1;
  }

  .pieza:focus-within .overlay-contenido {
    transform: translateY(0);
  }

  .pieza[data-oculta] {
    display: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pieza:hover :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay,
    .overlay-contenido,
    .pieza :global(img) {
      transition: none;
    }
  }

  .cierre {
    display: grid;
    gap: var(--espacio-md);
    padding-inline: var(--margen);
    margin-top: var(--espacio-xl);
  }

  .nota {
    color: var(--sobre-tinta-suave);
    max-width: 40ch;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espacio-md);
  }

  .enlace-instagram {
    font-size: var(--texto-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--tinta-media);
    transition: border-color 0.4s var(--salida);
  }

  .enlace-instagram:hover {
    border-color: var(--papel);
  }

  @media (min-width: 48rem) {
    .mosaico {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espacio-xs);
    }
  }

  @media (min-width: 75rem) {
    .mosaico {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  const galerias = document.querySelectorAll('[data-galeria-lista]')

  galerias.forEach((galeria) => {
    const filtros = galeria.closest('[data-invertido]')?.querySelectorAll('[data-filtro]')
    const piezas = galeria.querySelectorAll('[data-categorias]')

    filtros?.forEach((filtro) => {
      filtro.addEventListener('click', () => {
        const categoria = filtro.getAttribute('data-filtro')

        filtros.forEach((otro) => {
          const activo = otro === filtro
          otro.classList.toggle('activo', activo)
          otro.setAttribute('aria-pressed', String(activo))
        })

        piezas.forEach((pieza) => {
          const visible = categoria === 'todos' || pieza.getAttribute('data-categorias')?.split(' ').includes(categoria ?? '')
          pieza.toggleAttribute('data-oculta', !visible)
        })
      })
    })
  })
</script>
