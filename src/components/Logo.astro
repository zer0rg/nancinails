---
/**
 * Firma de Nanci Nails.
 *
 * El nombre sigue siendo texto HTML: conserva nitidez, accesibilidad y la
 * Bodoni de la marca de agua histórica.
 */
type Props = {
  /** Permite usar la firma dentro de distintos contextos semánticos. */
  como?: 'h1' | 'p' | 'span'
  tamano?: 'normal' | 'grande'
}

const { como: Etiqueta = 'span', tamano = 'normal' } = Astro.props
---

<Etiqueta class="logo" data-tamano={tamano}>
  <span class="firma">
    <span class="nombre"><span>Nanci</span> <em>Nails</em></span>
    <span class="especialidad" aria-hidden="true">Pedicura <i>y</i> manicura</span>
  </span>
</Etiqueta>

<style>
  .logo {
    display: inline-block;
    margin: 0;
    color: var(--tinta);
  }

  .firma {
    display: grid;
    gap: 0.3rem;
  }

  .nombre {
    display: block;
    white-space: nowrap;
    font-family: var(--display);
    font-optical-sizing: auto;
    font-size: 1.52rem;
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.025em;
  }

  .nombre em {
    font-style: italic;
    font-weight: 400;
  }

  .especialidad {
    display: block;
    padding-left: 0.08em;
    color: var(--grafito);
    font-family: var(--texto);
    font-size: 0.49rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .especialidad i {
    color: var(--laca);
    font-style: normal;
  }

  .logo[data-tamano='grande'] .nombre {
    font-size: 2rem;
  }

  .logo[data-tamano='grande'] .especialidad {
    font-size: 0.56rem;
  }
</style>
