---
import Logo from './Logo.astro'
import { negocio, direccionLegible } from '../data/negocio'
import { paginasServicio } from '../data/paginasServicio'

/**
 * Páginas legales: obligación de la LSSI-CE y del RGPD, y su sitio es el pie,
 * que es donde la gente las busca.
 *
 * Los datos identificativos (titular, NIF, domicilio) no hubo que pedirlos: la
 * propia dueña ya los tenía publicados en el aviso legal de la web antigua.
 */
const legales = [
  { texto: 'Aviso legal', destino: '/aviso-legal/' },
  { texto: 'Política de privacidad', destino: '/politica-de-privacidad/' },
  { texto: 'Política de cookies', destino: '/politica-de-cookies/' },
]

const anio = new Date().getFullYear()
---

<footer class="pie">
  <div class="marca">
    <Logo tamano="grande" como="p" />
    <p class="descripcion">{negocio.descripcion}</p>
  </div>

  <div class="datos">
    <address class="direccion">{direccionLegible}</address>
    <a class="enlace toque" href={`tel:${negocio.contacto.movilE164}`}>{negocio.contacto.movil}</a>
    <a class="enlace toque" href={`mailto:${negocio.contacto.email}`}>{negocio.contacto.email}</a>
  </div>

  {/*
    Enlace a las páginas de servicio desde todas las páginas del sitio.

    No es relleno de pie: una página a la que no apunta nada tarda semanas en
    ser rastreada y no recibe autoridad de la portada. Este bloque es lo que
    conecta el trabajo de SEO local con el resto de la web.
  */}
  <nav class="servicios" aria-label="Servicios">
    {
      paginasServicio.map((pagina) => (
        <a class="enlace toque" href={`/${pagina.slug}/`}>
          {pagina.etiqueta} en Rivas
        </a>
      ))
    }
  </nav>

  <nav class="redes" aria-label="Redes sociales">
    <a class="enlace toque" href={negocio.redes.instagram} target="_blank" rel="noopener noreferrer">
      Instagram
    </a>
    <a class="enlace toque" href={negocio.redes.facebook} target="_blank" rel="noopener noreferrer">
      Facebook
    </a>
  </nav>

  <div class="creditos">
    <p>© {anio} {negocio.nombre}</p>

    <nav class="legales" aria-label="Información legal">
      {
        legales.map((legal) => (
          <a class="enlace toque" href={legal.destino}>
            {legal.texto}
          </a>
        ))
      }

      {/*
        Retirar el consentimiento tiene que ser tan posible como darlo: lo exige
        el RGPD. Vuelve a abrir el aviso de cookies.
      */}
      <button type="button" class="enlace boton-cookies toque" data-abrir-cookies>
        Configuración de cookies
      </button>
    </nav>
  </div>
</footer>

<style>
  .pie {
    display: grid;
    gap: var(--espacio-lg);
    padding: var(--espacio-2xl) var(--margen) var(--espacio-xl);
    border-top: 1px solid var(--linea);
  }

  .descripcion {
    margin-top: var(--espacio-2xs);
    color: var(--grafito);
    font-size: var(--texto-sm);
    max-width: 30ch;
  }

  /* Hueco generoso: las áreas táctiles ampliadas no deben solaparse. */
  .datos,
  .servicios,
  .redes {
    display: grid;
    justify-items: start;
    gap: var(--espacio-md);
    font-size: var(--texto-sm);
  }

  .direccion {
    color: var(--grafito);
    font-style: normal;
    max-width: 26ch;
  }

  .enlace {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--salida);
  }

  .enlace:hover {
    border-color: var(--tinta);
  }

  .creditos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-sm) var(--espacio-lg);
    color: var(--grafito);
    font-size: var(--texto-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legales {
    display: flex;
    flex-wrap: wrap;
    /* Hueco amplio: las áreas táctiles ampliadas de .toque no deben solaparse. */
    gap: var(--espacio-sm) var(--espacio-lg);
  }

  .legales .enlace {
    color: inherit;
  }

  /* Es un <button> porque abre un diálogo, no navega. Se le quita la apariencia
     de control para que lea igual que los enlaces de al lado. */
  .boton-cookies {
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  @media (min-width: 48rem) {
    .pie {
      /* Cuatro columnas desde que entraron los servicios: marca, datos,
         servicios y redes. Con tres, el bloque nuevo caía a una segunda fila
         y dejaba el pie descuadrado. */
      grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--espacio-lg) var(--espacio-md);
      align-items: start;
    }

    .creditos {
      grid-column: 1 / -1;
      margin-top: var(--espacio-lg);
      padding-top: var(--espacio-md);
      border-top: 1px solid var(--linea);
    }
  }

  /* La barra fija de móvil taparía el final del pie. */
  @media (max-width: 47.99rem) {
    .pie {
      padding-bottom: calc(var(--espacio-xl) + 4.5rem);
    }
  }
</style>
