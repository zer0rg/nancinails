---
import BotonReserva from './BotonReserva.astro'
import { negocio, enlaceMapa, mapaIncrustado, direccionLegible } from '../data/negocio'

/**
 * Dirección, horario y contacto.
 *
 * El indicador "abierto ahora" se calcula siempre en hora de Madrid, no en la
 * del dispositivo: una clienta consultando desde otro huso vería un estado
 * falso, y eso es peor que no mostrar nada.
 *
 * El mapa incrustado va en escala de grises. Aquí sí procede desaturar: el
 * color en esta web está reservado a las fotos del trabajo, y un mapa con los
 * verdes y amarillos de Google rompería la paleta entera.
 *
 * ⚠️ El iframe de Google instala cookies de terceros en cuanto carga. Hay que
 * declararlo en la política de cookies (pendiente, ver README). Se difiere su
 * carga para no penalizar el rendimiento de la página.
 */

// Índice de Date.getDay(): 0 es domingo. El array empieza en lunes.
const horarioParaScript = negocio.horario.map((dia) => ({
  abre: dia.abre,
  cierra: dia.cierra,
}))
---

<section class="seccion donde" id="donde">
  <div class="cabecera-seccion">
    <h2 class="titulo-seccion">Dónde estamos</h2>
    <p class="entradilla">
      En el {negocio.direccion.local}, en {negocio.direccion.ciudad}.
    </p>
  </div>

  <div class="columnas">
    <div class="bloque">
      <h3 class="etiqueta">Dirección</h3>
      <address class="direccion">
        {direccionLegible}
      </address>
      <a class="enlace toque" href={enlaceMapa} target="_blank" rel="noopener noreferrer">
        Abrir en Google Maps
      </a>
    </div>

    <div class="bloque">
      <h3 class="etiqueta">Horario</h3>

      <p class="estado" data-estado data-horario={JSON.stringify(horarioParaScript)} hidden>
        <span class="punto" aria-hidden="true"></span>
        <span data-estado-texto></span>
      </p>

      <table class="horario">
        <caption class="solo-lectores">Horario de apertura</caption>
        <tbody>
          {
            negocio.horario.map((dia) => (
              <tr>
                <th scope="row">{dia.dia}</th>
                <td>{dia.abre ? `${dia.abre} – ${dia.cierra}` : 'Cerrado'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="bloque">
      <h3 class="etiqueta">Contacto</h3>
      <ul class="contacto">
        <li>
          <a class="enlace toque" href={`tel:${negocio.contacto.movilE164}`}>
            {negocio.contacto.movil}
          </a>
          <span class="matiz">Móvil y WhatsApp</span>
        </li>
        <li>
          <a class="enlace toque" href={`tel:${negocio.contacto.fijoE164}`}>
            {negocio.contacto.fijo}
          </a>
          <span class="matiz">Fijo del salón</span>
        </li>
        <li>
          <a class="enlace toque" href={`mailto:${negocio.contacto.email}`}>
            {negocio.contacto.email}
          </a>
        </li>
      </ul>

      <div class="reserva">
        <BotonReserva />
      </div>
    </div>
  </div>

  {/*
    El iframe sale SIN `src`: la URL vive en `data-src-consentido` y solo se
    copia al atributo real cuando hay un sí explícito en el aviso de cookies.
    Con `src` puesto de salida, el navegador contactaría con Google y Google
    instalaría sus cookies antes de que nadie haya aceptado nada, que es
    exactamente lo que el artículo 22.2 de la LSSI prohíbe.
  */}
  <div class="mapa">
    <iframe
      data-src-consentido={mapaIncrustado}
      title={`Mapa de ubicación: ${direccionLegible}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>

    {/*
      Marcador mientras no hay consentimiento. No es un hueco vacío: repite la
      dirección, ofrece el enlace a Maps —que no instala nada hasta que se
      pulsa— y deja volver sobre la decisión.
    */}
    <div class="marcador" data-sin-consentimiento>
      <p class="donde-marcador">{negocio.direccion.local}</p>
      <p class="detalle-marcador">
        {negocio.direccion.numeroLocal} · {negocio.direccion.ciudad}
      </p>
      <p class="motivo">
        El mapa no se carga hasta que aceptas las cookies de Google.
      </p>
      <div class="opciones">
        <button type="button" class="accion-marcador" data-abrir-cookies>Cargar el mapa</button>
        <a
          class="accion-marcador"
          href={enlaceMapa}
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir en Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Marca si el salón está abierto en este momento.
   *
   * Se calcula en hora de Madrid mediante Intl, no con la hora local del
   * dispositivo. El bloque está oculto hasta que el cálculo termina: es
   * preferible no mostrar nada a mostrar un estado equivocado.
   */
  type Tramo = { abre: string | null; cierra: string | null }

  const contenedor = document.querySelector<HTMLElement>('[data-estado]')
  const salida = contenedor?.querySelector<HTMLElement>('[data-estado-texto]')

  if (contenedor && salida) {
    const horario: Tramo[] = JSON.parse(contenedor.dataset.horario ?? '[]')

    // Se pide en inglés a propósito: las abreviaturas de día en español varían
    // entre navegadores ("mié", "mié.", "MI"), las inglesas no.
    const formato = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Madrid',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    })

    const partes = formato.formatToParts(new Date())
    const valor = (tipo: Intl.DateTimeFormatPartTypes) =>
      partes.find((parte) => parte.type === tipo)?.value ?? ''

    // El array de horario empieza en lunes.
    const dias = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
    const indice = dias.indexOf(valor('weekday'))
    const minutosAhora = Number(valor('hour')) * 60 + Number(valor('minute'))

    const enMinutos = (hora: string) => {
      const [h, m] = hora.split(':').map(Number)
      return h * 60 + m
    }

    const tramo = indice >= 0 ? horario[indice] : undefined
    const abierto =
      !!tramo?.abre &&
      !!tramo.cierra &&
      minutosAhora >= enMinutos(tramo.abre) &&
      minutosAhora < enMinutos(tramo.cierra)

    if (indice >= 0) {
      contenedor.dataset.abierto = String(abierto)
      salida.textContent = abierto ? 'Abierto ahora' : 'Cerrado ahora'
      contenedor.hidden = false
    }
  }
</script>

<style>
  .cabecera-seccion {
    display: grid;
    gap: var(--espacio-sm);
    padding-inline: var(--margen);
    margin-bottom: var(--espacio-xl);
  }

  .columnas {
    display: grid;
    gap: var(--espacio-xl);
    padding-inline: var(--margen);
  }

  .bloque {
    display: grid;
    align-content: start;
    gap: var(--espacio-xs);
    padding-top: var(--espacio-md);
    border-top: 1px solid var(--linea);
  }

  .etiqueta {
    color: var(--grafito);
    font-family: var(--texto);
    font-size: var(--texto-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .direccion {
    font-family: var(--display);
    font-optical-sizing: auto;
    font-size: var(--texto-lg);
    font-style: normal;
    line-height: 1.3;
    max-width: 22ch;
  }

  .estado {
    display: flex;
    align-items: center;
    gap: var(--espacio-2xs);
    font-size: var(--texto-sm);
    font-weight: 500;
  }

  .punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--borde);
  }

  /* Verde abierto, gris cerrado. El rojo se descartó: junto a "Abierto ahora"
     contradice al propio texto. */
  .estado[data-abierto='true'] .punto {
    background: var(--abierto);
  }

  .estado[data-abierto='false'] {
    color: var(--grafito);
  }

  .horario {
    border-collapse: collapse;
    font-size: var(--texto-sm);
    font-variant-numeric: tabular-nums;
  }

  .horario th {
    font-weight: 400;
    text-align: left;
    padding-right: var(--espacio-md);
    padding-block: 0.2rem;
  }

  .horario td {
    color: var(--grafito);
    padding-block: 0.2rem;
    white-space: nowrap;
  }

  /* El hueco entre elementos es mayor que el mínimo estético a propósito:
     las áreas táctiles ampliadas de los enlaces no deben tocarse entre sí. */
  .contacto {
    display: grid;
    gap: var(--espacio-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contacto li {
    display: grid;
    gap: 0.1rem;
  }

  .enlace {
    justify-self: start;
    text-decoration: none;
    border-bottom: 1px solid var(--borde);
    padding-bottom: 0.15rem;
    transition: border-color 0.4s var(--salida);
  }

  .enlace:hover {
    border-color: var(--tinta);
  }

  .matiz {
    color: var(--grafito);
    font-size: var(--texto-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .reserva {
    margin-top: var(--espacio-xs);
  }

  /* Sangra de borde a borde: el mapa cierra la sección como una franja, no
     como un recuadro metido dentro del contenido. */
  .mapa {
    margin-top: var(--espacio-xl);
    line-height: 0;
    /* La escala de grises integra el mapa en la paleta. Al interactuar
       recupera el color, porque ahí ya manda la legibilidad sobre la estética:
       las carreteras y los parques se distinguen mejor. */
    filter: grayscale(1) contrast(1.06);
    transition: filter 0.6s var(--salida);
  }

  .mapa:hover,
  .mapa:focus-within {
    filter: none;
  }

  .mapa iframe {
    display: block;
    width: 100%;
    height: clamp(16rem, 42vh, 28rem);
    border: 0;
  }

  /* Sin consentimiento el iframe está vacío y no debe reservar altura: la ocupa
     el marcador, que mide exactamente lo mismo. */
  .mapa iframe:not([src]) {
    display: none;
  }

  /* Mismo motivo que en el aviso de cookies: `display` de autor pisa a
     `[hidden]`, y sin esto el marcador seguiría encima del mapa ya cargado. */
  .marcador[hidden] {
    display: none;
  }

  .marcador {
    /*
      `.mapa` lleva `line-height: 0` para matar el hueco de descendente que el
      navegador deja bajo un iframe. El marcador lo heredaba y sus párrafos
      salían con altura CERO: el texto se pintaba encima de sí mismo. Aquí se
      recupera la interlínea normal del cuerpo.
    */
    line-height: 1.6;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--espacio-2xs);
    height: clamp(16rem, 42vh, 28rem);
    padding: var(--espacio-lg) var(--margen);
    text-align: center;
    background: var(--papel-hueso);
  }

  .donde-marcador {
    font-family: var(--display);
    font-size: var(--texto-lg);
  }

  .detalle-marcador {
    color: var(--tinta-media);
    font-size: var(--texto-sm);
  }

  .motivo {
    max-width: 34ch;
    margin-top: var(--espacio-2xs);
    color: var(--grafito);
    font-size: var(--texto-xs);
    text-wrap: pretty;
  }

  .opciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-md);
    margin-top: var(--espacio-sm);
  }

  .accion-marcador {
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--borde);
    color: var(--tinta);
    font-family: var(--texto);
    font-size: var(--texto-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.4s var(--salida);
  }

  .accion-marcador:hover {
    border-color: var(--tinta);
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .columnas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espacio-lg);
    }
  }
</style>
