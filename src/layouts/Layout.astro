---
import '@fontsource-variable/bodoni-moda'
// La cursiva de la Bodoni carga aparte y solo se usa en el titular de portada.
// Es el gesto editorial que separa una portada de moda de una web genérica.
import '@fontsource-variable/bodoni-moda/wght-italic.css'
import '@fontsource-variable/jost'
import '../styles/global.css'

import AvisoCookies from '../components/AvisoCookies.astro'
import SEO from '../components/SEO.astro'
import JsonLd from '../components/JsonLd.astro'
import { direccionLegible } from '../data/negocio'
import { esquemaNegocio } from '../lib/schema'

type Props = {
  titulo: string
  descripcion: string
  /** URL preferida absoluta o relativa. Por defecto se usa la ruta actual. */
  canonical?: URL | string
  /** Imagen social absoluta o relativa. */
  image?: URL | string
  ogType?: string
  /** Para páginas que no deben aparecer en Google, como la 404. */
  sinIndexar?: boolean
  /**
   * Marcado adicional de schema.org: migas de pan, `Service`, etc.
   * El `NailSalon` va en todas las páginas indexables y no hace falta pasarlo.
   */
  esquemas?: Record<string, unknown>[]
}

const {
  titulo,
  descripcion,
  canonical: canonicalProp,
  image,
  ogType = 'website',
  sinIndexar = false,
  esquemas = [],
} = Astro.props

// Política única: HTTPS, sin www y barra final (salvo la raíz, que ya la lleva).
const rutaActual =
  Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`
const canonical = new URL(canonicalProp ?? rutaActual, Astro.site)

/*
 * Los despliegues de vista previa se marcan como no indexables.
 *
 * Sin esto, Google puede indexar la copia de pruebas y hacerle la competencia
 * al dominio real, que es lo último que le conviene a un negocio local.
 */
const esProduccion = Astro.site?.hostname === 'nancinails.es'
const indexable = esProduccion && !sinIndexar
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEO
      title={titulo}
      description={descripcion}
      canonical={canonical}
      image={image}
      ogType={ogType}
      noindex={!indexable}
    />

    <meta name="geo.region" content="ES-M" />
    <meta name="geo.placename" content={direccionLegible} />

    {indexable && <JsonLd data={esquemaNegocio()} />}
    {indexable && esquemas.map((esquema) => <JsonLd data={esquema} />)}
  </head>

  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <slot />
    {/* Va en el Layout para que el consentimiento valga en todo el sitio. */}
    <AvisoCookies />
  </body>
</html>
